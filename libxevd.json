{
    "name": "libxevd",
    "version": "1.0.1",
    "description": "MPEG-5 EVC (Essential Video Coding) decoder",
    "filters":["evcdec"],
    "help": "This filter decodes raw EVC elementary streams using xevd.",
    "support": [
        "video"
    ],
    "sources":"https://bevara.ddns.net/sources/libxevd.accessor",
    "filter_source":{
        "evcdec" : "dec_evc.c"
    },
    "extension":{
      "evc" : "video"
    },
    "using": ["mm_solver_minimal_1.0.1", "mm_solver_1.0.1", "mm_solver_1.0.2", "mm_solver_1.0.3", "mm_solver_1.0.4"],
    "patents": {
        "status": "licence-required",
        "note": "EVC main profile (the baseline profile is royalty-free)",
        "checked": "2026-10-16"
    }
}
